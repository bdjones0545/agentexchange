{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/reconcile-payments.ts": {
      "maxDuration": 60
    },
    "api/*.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/reconcile-payments",
      "schedule": "*/5 * * * *"
    }
  ]
}
