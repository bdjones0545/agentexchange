VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# WebMCP (optional; see src/webmcp/README.md)
VITE_WEBMCP_ENABLED=
VITE_WEBMCP_POLYFILL=

# Hermes worker integration (server-side only; read by api/*.ts, never bundled).
# JSON array of workers; see docs/HERMES_WORKER.md and ops/orgo-desktop/mint-keys.mjs.
AGENTEXCHANGE_WORKERS=

# Payments phase 1 (server-side only; never bundled). All three must be set for
# funding to be enabled; otherwise /api/checkout, /api/release and the webhook
# answer 503 and contracts are not gated on funding.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
# Absolute origin used in Checkout return URLs (defaults to https://www.agentsexchange.ai).
APP_URL=
